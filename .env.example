# Local and devnet defaults only. Never put a mainnet URL or a private key here (MER-01, SEC-07).
# Services (Phase 4+) add their variables here as they land.
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_WS_URL=ws://127.0.0.1:8900
MERIDIAN_PROGRAM_ID=2U1R1Y6LNi9GoAp1TMo2JXssjxxnJe5iLf6g2PLzXmhL
# Property test knobs (programs/meridian/tests/invariants_prop.rs)
PROP_SEQUENCES=10000

# ---- Automation service (services/automation, Phase 4). Ops tier: own RPC, own keys. ----
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/meridian
REDIS_URL=redis://127.0.0.1:6379
AUTOMATION_RPC_URL=http://127.0.0.1:8899
# Keypair files (JSON arrays). Only these three; never an admin or upgrade key (D23).
AUTOMATION_PAYER_KEYPAIR=./keys/automation-payer.json
MARKET_CREATOR_KEYPAIR=./keys/market-creator.json
SETTLER_KEYPAIR=./keys/settler.json
PRIORITY_MICROLAMPORTS=0
MAX_PRIORITY_MICROLAMPORTS=1000000
HERMES_URL=https://hermes.pyth.network
# Official close (D3, D13) and implied vol (D9)
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
DATABENTO_API_KEY=
DATABENTO_DATASET=XNAS.ITCH
# Optional JSON file with {"closed": [...], "halfDays": [...]} for one-off exchange closures
CALENDAR_OVERRIDES=
