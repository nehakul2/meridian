# Local and devnet defaults only. Never put a mainnet URL or a private key here (MER-01, SEC-07).
# Services (Phase 4+) add their variables here as they land.
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_WS_URL=ws://127.0.0.1:8900
MERIDIAN_PROGRAM_ID=2U1R1Y6LNi9GoAp1TMo2JXssjxxnJe5iLf6g2PLzXmhL
# Property test knobs (programs/meridian/tests/invariants_prop.rs)
PROP_SEQUENCES=10000

# ---- Automation service (services/automation, Phase 4). Ops tier: own RPC, own keys. ----
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/meridian
REDIS_URL=redis://127.0.0.1:6379
AUTOMATION_RPC_URL=http://127.0.0.1:8899
# Keypair files (JSON arrays). Only these three; never an admin or upgrade key (D23).
AUTOMATION_PAYER_KEYPAIR=./keys/automation-payer.json
MARKET_CREATOR_KEYPAIR=./keys/market-creator.json
SETTLER_KEYPAIR=./keys/settler.json
PRIORITY_MICROLAMPORTS=0
MAX_PRIORITY_MICROLAMPORTS=1000000
HERMES_URL=https://hermes.pyth.network
# Official close (D3, D13) and implied vol (D9)
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
DATABENTO_API_KEY=
DATABENTO_DATASET=XNAS.ITCH
# Optional JSON file with {"closed": [...], "halfDays": [...]} for one-off exchange closures
CALENDAR_OVERRIDES=

# ---- REST API, Tx Builder, WebSocket gateway (Phase 6). Public tier: no keys, ever. ----
PG_URL=postgres://postgres:postgres@127.0.0.1:5432/meridian
PG_READ_URL=postgres://postgres:postgres@127.0.0.1:5432/meridian
# HS256 secret shared by the API (issues tokens) and the WS gateway (checks them)
JWT_SECRET=
SIWS_DOMAIN=localhost
# Comma-separated multisig signer wallets allowed on /v1/admin, and the Squads vault that pays admin txs
ADMIN_SIGNERS=
ADMIN_AUTHORITY=
USDC_MINT=
FEE_VAULT=
BOND_VAULT=
RPC_URL=http://127.0.0.1:8899

# ---- Devnet scripts (Phase 8, make deploy-devnet / lifecycle-devnet / release-devnet). ----
# Devnet only: the scripts check the genesis hash and refuse any other cluster.
DEVNET_RPC_URL=https://api.devnet.solana.com
# A funded devnet wallet (~15 SOL while deploying) and the keypair for the IDL's program id
DEPLOYER_KEYPAIR=~/.config/solana/id.json
PROGRAM_KEYPAIR=target/deploy/meridian-keypair.json
# Role keys are generated here on first run and must be kept: Config records them
DEVNET_DIR=.devnet
# Optional {"AAPL": "<feed id hex>", ...}; otherwise looked up on Hermes by symbol
FEEDS_FILE=
TICKER=AAPL
# Trading-date key YYYYMMDD for the smoke market; default is a fresh key per run
DATE=
TRADE_WINDOW_S=240
# Release smoke opens a bug issue here on failure (CI sets both)
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# ---- Monitor (Phase 8). Reads Postgres (DATABASE_URL above), Redis, RPC and the gateways' /healthz. ----
PROGRAM_ID=2U1R1Y6LNi9GoAp1TMo2JXssjxxnJe5iLf6g2PLzXmhL
WS_HEALTH_URLS=http://127.0.0.1:8082/healthz
ONCALL_WEBHOOK_URL=
CHECK_INTERVAL_S=30

# ---- Load harness (tests/load, nightly) ----
LOAD_SCALE=1
API_INSTANCES=4
TXB_RPS=500
LOAD_REPORT=
LOAD_INCLUDE=
RESIDUAL_PER_DAY_SOL=0.59
