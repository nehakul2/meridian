{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    // Test helpers import the Indexer projector, whose ioredis types live in services/indexer/node_modules,
    // which CI does not install. Resolve them from this service's own copy.
    "paths": { "ioredis": ["./node_modules/ioredis/built/index.d.ts"] }
  },
  "include": [
    "src",
    
    "test",
    "../shared/src"
  ]
}