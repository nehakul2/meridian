{
  "name": "@meridian/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian Indexer (C6): event decoder, Redis projector, md:events stream, leader election and backfill",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
