{
  "name": "@meridian/txb",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian Tx Builder (C3): maps user intents to unsigned Meridian transactions, with position, size and state guards",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/txb/src/main.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.2",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.20.7",
    "litesvm": "^0.8.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
