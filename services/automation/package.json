{
  "name": "@meridian/automation",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian automation service (C8): calendar, strikes, morning job, settler, cranks, scheduler, reconcile",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/src/main.js",
    "calendar:load": "node dist/src/cli.js calendar-load",
    "spike:close": "node dist/scripts/close-spike.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@pythnetwork/pyth-solana-receiver": "^0.11.0",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.2",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "litesvm": "^0.8.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
